<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RGBcontroller.Core\RGBcontroller.Core.csproj" />
    <ProjectReference Include="..\RGBcontroller.Ipc\RGBcontroller.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RGBcontroller.Tests" />
  </ItemGroup>

  <!-- Pinned OpenRGB copy (tools/Get-PinnedOpenRgb.ps1) lands next to the exe as openrgb\. -->
  <ItemGroup Condition="Exists('..\..\third_party\openrgb\OpenRGB.exe')">
    <None Include="..\..\third_party\openrgb\**\*" LinkBase="openrgb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
