<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\rgbcontroller.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RGBcontroller.Core\RGBcontroller.Core.csproj" />
    <ProjectReference Include="..\RGBcontroller.Ipc\RGBcontroller.Ipc.csproj" />
  </ItemGroup>

  <!-- The web front end (ui/, React + Vite) builds into ui/dist; the shell serves it from wwwroot. -->
  <ItemGroup>
    <Content Include="..\..\ui\dist\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fallback\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\rgbcontroller.ico" Link="rgbcontroller.ico" />
    <!-- Also next to the exe: shortcuts point at this file, so an icon change is not hidden by Explorer's icon cache. -->
    <None Include="..\..\assets\rgbcontroller.ico" Link="rgbcontroller.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RGBcontroller.Tests" />
  </ItemGroup>

</Project>
